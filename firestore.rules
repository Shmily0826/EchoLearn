rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User data: users/{uid}/data/{collection}
    // Only the authenticated owner can read/write their own data
    match /users/{userId}/data/{collection} {
      // Owner-only, AND the email must be verified. Unverified email/password
      // accounts cannot read or write their cloud data — this prevents
      // throwaway/fake-email accounts from polluting or reading sync data.
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    // Shared AI analysis cache: aiAnalyses/{cacheKey}
    // Public-read (content is non-PII AI output of public transcripts) so the
    // cache is shared across all users; only authenticated users may write,
    // and only the expected shape (bounded content + timestamp).
    match /aiAnalyses/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.content is string
        && request.resource.data.content.size() < 500000
        && request.resource.data.createdAt is int;
    }

    // User feedback: feedback/{docId}
    // Only the authenticated owner may create a doc about themselves. The
    // developer reads submissions from the Firebase console (admin, bypasses
    // rules) — clients get no read/write/delete.
    match /feedback/{docId} {
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 5000
        && (request.resource.data.userEmail is string || request.resource.data.userEmail == null)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
