rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Cloud sync, feedback and the AI cache are all gated on a verified email:
    // an unverified throwaway account must not be able to write or wipe data.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // ── Personal sync data: users/{userId}/data/{collection} ─────────────
    // Owner-only; the owner identity is the path segment, so no query can
    // reach outside it.
    match /users/{userId}/data/{collection} {
      allow read, write: if isVerified() && request.auth.uid == userId;
    }

    // ── Shared AI analysis cache, LEGACY ─────────────────────────────────
    // Written under the pre-2026 rules by any signed-in client, including an
    // unverified one, so it can no longer be trusted as an authoritative
    // store. It is frozen: still readable (public, non-PII AI output about a
    // public transcript) and usable as a cache HIT, but no client may create,
    // update or delete any document here — a poisoned legacy doc cannot be
    // added, and a legitimate one cannot be overwritten. New writes go to
    // aiCache below, where the writer is bound to the document path.
    match /aiAnalyses/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── AI analysis cache, owner-scoped ───────────────────────────────────
    // aiCache/{writerId}/analyses/{cacheKey}: a client may only populate its
    // own subtree, and only a verified session may write at all. Nobody else
    // can read it, so an attacker cannot inject or overwrite the result any
    // other learner is served, and cannot pre-create a trusted entry under a
    // predictable key for someone else's video.
    match /aiCache/{writerId}/analyses/{cacheKey} {
      allow read, write: if isVerified() && request.auth.uid == writerId;
    }

    // ── Feedback, owner-scoped subtree ────────────────────────────────────
    // feedback/{userId}/messages/{messageId}: nesting the writer's uid in the
    // path is what makes the owner's own list/get/delete provably bounded, so
    // account deletion can actually remove the PII it promised to remove.
    // The developer reads submissions from the Firebase console (admin bypasses
    // rules); no other signed-in user may read, write or delete them.
    // `list` carries an explicit limit because the query must mirror the rule
    // (firebase.google.com/docs/firestore/security/rules-query); the uid is
    // already pinned by the path, so no field predicate is needed.
    match /feedback/{userId}/messages/{messageId} {
      allow get, write: if isVerified() && request.auth.uid == userId;
      allow list: if isVerified() && request.auth.uid == userId
        && request.query.limit <= 50;
    }

    // ── Feedback, LEGACY flat documents ──────────────────────────────────
    // feedback/{docId} was created with an autogenerated id the submitting
    // client never kept, and no rule ever allowed it to read or list them, so
    // no owner-side deletion rule can reach them: the client cannot name the
    // documents it would delete. They stay closed to clients and can only be
    // removed by an administrator from the Firebase console — see
    // DECISIONS.md (ECHO_AUTH_DATA_AND_AI_CACHE_SAFETY_V1).
    match /feedback/{docId} {
      allow create: if isVerified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 5000
        && (request.resource.data.userEmail is string || request.resource.data.userEmail == null)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
