{
  "name": "echolearn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:emulator:run": "vitest run --config vitest.emulator.config.ts",
    "test:emulator": "node scripts/run-firestore-emulator.mjs",
    "test:ci": "npm test && npm run build && npm run lint && npm run test:emulator",
    "test:worker": "node --test cf-worker/test/*.test.mjs",
    "test:reliability": "node --test scripts/reliability-baseline/*.test.mjs",
    "test:vps": "python -m unittest discover -s vps-ytdlp -p \"test*.py\"",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=desktop-chromium e2e/golden-path.spec.ts e2e/study-english-i18n.spec.ts",
    "e2e:mobile": "playwright test --project=mobile-chromium --project=mobile-webkit",
    "e2e:real-auth": "playwright test --config playwright.real-auth.config.ts",
    "health": "node scripts/health-check.mjs",
    "ai:rubric": "node --experimental-strip-types scripts/ai-quality-rubric.mjs",
    "ai:seek-smoke": "node scripts/ai-seek-smoke.mjs",
    "deploy:check": "node scripts/prod-deploy-check.mjs",
    "dict:eval": "node scripts/dictionary-evaluation.ts",
    "dict:eval:synthetic": "node scripts/dictionary-evaluation.ts --csv scripts/fixtures/dictionary-eval.synthetic.ecdict.csv --synthetic-fixture --self-check",
    "dict:context": "node scripts/dictionary-context-poc.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "~8.4.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "~8.4.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@google/genai": "^2.18.0",
    "@sentry/react": "^10.67.0",
    "@vercel/analytics": "^2.0.1",
    "driver.js": "^1.8.0",
    "firebase": "^12.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.4.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^13.35.1",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.1",
    "terser": "^5.49.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
