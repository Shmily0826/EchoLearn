{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/transcript.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/yt", "destination": "/api/yt" },
    { "source": "/api/youtube", "destination": "/api/youtube" },
    { "source": "/api/transcript", "destination": "/api/transcript" },
    { "source": "/api/ai", "destination": "/api/ai" },
    { "source": "/api/translate", "destination": "/api/translate" },
    { "source": "/api/dictionary", "destination": "/api/dictionary" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
